# Sakha (SFIC - Secure Bharat) Environment Configuration

# Optional Backend Port & URL (defaults to http://localhost:3000)
PORT=3000
BACKEND_URL=http://localhost:3000

# Optional VLM / LLM Provider for Explain Feature (strictly masked text only)
# Options: groq | ollama | gemini
VLM_MODE=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://127.0.0.1:11434
