{
  "manifest_version": 3,
  "name": "Sakha (సఖ) — On-Device Senior Safety Companion",
  "version": "1.1.0",
  "description": "On-device digital safety companion for senior citizens in India. Blurs sensitive details on screen and alerts against scams.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "offscreen",
    "storage"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },

  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["sakha.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "demo/fake-kyc.html",
        "demo/upi-collect-trap.html",
        "demo/genuine-service-form.html",
        "demo/genuine-banking.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Sakha (సఖ)"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}

